# Hanya untuk `npm run dev` dengan API yang sudah dikunci API key.
# Jangan pakai prefix VITE_: nilai ini hanya dibaca dev server, bukan browser.
API_TARGET=https://komik-api-pengembangan.vercel.app
KOMIK_API_KEY=

# Untuk production di Vercel, set KOMIK_API_KEY di Project Settings.
# Proxy /api/[...path].js yang menambahkan key ke request server-side.
